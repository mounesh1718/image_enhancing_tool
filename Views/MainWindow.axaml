<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ImageQualityEnhancer.ViewModels"
        x:Class="ImageQualityEnhancer.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1280" Height="820" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Title="Image Quality Enhancer">

    <!-- The page (start or job) is chosen by the view model; ViewLocator maps it to its view. -->
    <ContentControl Content="{Binding CurrentPage}" />

</Window>
